{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs2-market-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Cron: каждую минуту вызывается планировщик; он сам решает, какие источники пора опрашивать.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cs2-market-bot",
      // Вставь сюда Database ID из Cloudflare → Storage & Databases → D1 → cs2-market-bot.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
