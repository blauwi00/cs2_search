{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs2-search",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Публичный адрес *.workers.dev нужен для webhook Telegram и страниц /admin/*.
  "workers_dev": true,
  // Не удалять переменные, добавленные в панели Cloudflare, при деплое из GitHub.
  "keep_vars": true,
  // Steam и Skinport опрашивает GitHub Actions (.github/workflows/collect.yml), а не Worker.
  "vars": { "COLLECTOR": "github" },
  "observability": { "enabled": true },
  // Cron: каждую минуту вызывается планировщик; он сам решает, какие источники пора опрашивать.
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cs2-market-bot",
      // Вставь сюда Database ID из Cloudflare → Storage & Databases → D1 → cs2-market-bot.
      "database_id": "c2ee6ccc-1c47-4e07-87d2-69385047a64e",
      "migrations_dir": "migrations"
    }
  ]
}
